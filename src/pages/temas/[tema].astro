---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import ThemeNav from "../../components/ThemeNav.astro";
import { getPosts, TEMAS, type Tema } from "../../lib/posts";

export function getStaticPaths() {
  return Object.keys(TEMAS).map((tema) => ({ params: { tema } }));
}

const tema = Astro.params.tema as Tema;
const posts = (await getPosts()).filter((p) => p.data.tema === tema);
---

<Base title={`${TEMAS[tema]} | Moises Salgado`} description={`Escritos sobre ${TEMAS[tema].toLowerCase()}.`}>
  <header class="container page-title">
    <p class="eyebrow">Tema</p>
    <h1>{TEMAS[tema]}</h1>
  </header>
  <div class="container"><ThemeNav current={tema} /></div>
  <section class="container stack">
    {posts.length ? posts.map((p) => <PostCard id={p.id} {...p.data} />) : <p class="empty">Nada por aqui ainda.</p>}
  </section>
</Base>
