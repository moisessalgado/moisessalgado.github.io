---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projetos = (await getCollection("projetos")).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base title="Projetos | Moises Salgado" description="Projetos pessoais e open source de Moises Salgado.">
  <header class="container page-title">
    <p class="eyebrow">Projetos</p>
    <h1>Projetos</h1>
  </header>

  <section class="container stack">
    {
      projetos.length ? (
        projetos.map((p) => (
          <article class="card project-card reveal">
            <h3><a href={p.data.url}>{p.data.nome}</a></h3>
            <p>{p.data.descricao}</p>
          </article>
        ))
      ) : (
        <p class="empty">Em breve.</p>
      )
    }
  </section>
</Base>
