---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, TEMAS, fmtDate } from "../../lib/posts";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tema } = post.data;
---

<Base title={`${title} | Moises Salgado`} description={description} type="article">
  <article class="container">
    <header class="page-title prose">
      <p class="eyebrow">
        <a href={`/temas/${tema}`}>{TEMAS[tema]}</a> · <time datetime={date.toISOString()}>{fmtDate(date)}</time>
      </p>
      <h1>{title}</h1>
    </header>
    <div class="card prose">
      <Content />
    </div>
    <p class="prose"><a href="/escritos">← Todos os escritos</a></p>
  </article>
</Base>
