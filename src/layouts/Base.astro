---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "pt" | "en";
  /** Path of the same page in the other language (institutional pages only). */
  alt?: string;
  type?: "website" | "article";
}

const { title, description, lang = "pt", alt, type = "website" } = Astro.props;
const site = "https://moisessalgado.com.br";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, site).href;
const image = `${site}/assets/og-card.svg`;
const t =
  lang === "pt"
    ? {
        skip: "Pular para o conteúdo principal",
        nav: "Navegação principal",
        items: [
          ["/sobre", "Sobre"],
          ["/consultoria", "Consultoria"],
          ["/escritos", "Escritos"],
          ["/projetos", "Projetos"],
        ],
        home: "/",
        rights: "Todos os direitos reservados.",
      }
    : {
        skip: "Skip to main content",
        nav: "Main navigation",
        items: [
          ["/en/about", "About"],
          ["/en/consulting", "Consulting"],
          ["/escritos", "Writing (PT)"],
          ["/projetos", "Projects (PT)"],
        ],
        home: "/en/",
        rights: "All rights reserved.",
      };
const ptHref = lang === "pt" ? Astro.url.pathname : alt;
const enHref = lang === "en" ? Astro.url.pathname : alt;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Moises Salgado",
  url: `${site}/`,
  jobTitle: "Founder | Geospatial & Climate Intelligence Advisory",
  email: "mailto:contato@moisessalgado.com.br",
  sameAs: ["https://www.linkedin.com/in/moisessalgado/", "https://github.com/moisessalgado"],
  address: { "@type": "PostalAddress", addressLocality: "Florianopolis", addressCountry: "BR" },
};
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0057ff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Moises Salgado" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    {ptHref && <link rel="alternate" hreflang="pt-BR" href={new URL(ptHref, site).href} />}
    {enHref && <link rel="alternate" hreflang="en" href={new URL(enHref, site).href} />}
    {ptHref && <link rel="alternate" hreflang="x-default" href={new URL(ptHref, site).href} />}
    <link rel="alternate" type="application/rss+xml" title="Moises Salgado" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Sora:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="aurora aurora-a" aria-hidden="true"></div>
    <div class="aurora aurora-b" aria-hidden="true"></div>
    <a class="skip-link" href="#conteudo">{t.skip}</a>

    <header class="site-header">
      <a class="brand" href={t.home}>MS</a>
      <nav aria-label={t.nav}>
        {
          t.items.map(([href, label]) => (
            <a href={href} aria-current={path === href || path.startsWith(href + "/") ? "page" : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      {
        alt && (
          <div class="lang-switch" role="group" aria-label="Idioma / Language">
            <a class:list={{ active: lang === "pt" }} href={ptHref} lang="pt-BR">PT</a>
            <a class:list={{ active: lang === "en" }} href={enHref} lang="en">EN</a>
          </div>
        )
      }
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} Moises Salgado. {t.rights}
        · <a href="/rss.xml">RSS</a>
        · <a href="https://github.com/moisessalgado" rel="noreferrer">GitHub</a>
        · <a href="https://www.linkedin.com/in/moisessalgado/" rel="noreferrer">LinkedIn</a>
      </p>
    </footer>

    <script>
      const reveals = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      reveals.forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i * 60, 240)}ms`;
        observer.observe(el);
      });
    </script>
  </body>
</html>
